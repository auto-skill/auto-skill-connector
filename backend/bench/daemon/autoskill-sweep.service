[Unit]
Description=Auto-Skill corpus enumeration sweep (continuous, checkpoint-resumed)
StartLimitIntervalSec=0
StartLimitBurst=3
OnFailure=autoskill-alert@%n.service

[Service]
Type=simple
ExecStart=/srv/mobile-codex/autoskill-daemon/bin/sweep-loop.sh
Restart=on-failure
RestartSec=60
StandardOutput=append:/srv/mobile-codex/autoskill-daemon/logs/sweep-unit.log
StandardError=append:/srv/mobile-codex/autoskill-daemon/logs/sweep-unit.log
Nice=10

[Install]
WantedBy=default.target
