    {"id": "auth-design", "prompt": "Design a complete authentication and session system for a web app in 2026. Cover every component exhaustively, with specific algorithms and parameters.", "groups": [["argon2", "bcrypt", "scrypt"], ["salt"], ["work factor", "cost", "iterations", "memory", "rounds"], ["session", "token", "JWT", "cookie"], ["HttpOnly", "Secure", "SameSite"], ["expiry", "expiration", "TTL", "short-lived"], ["refresh token", "rotation", "revoke"], ["2FA", "MFA", "TOTP", "WebAuthn", "passkey"], ["rate limit", "lockout", "brute force"], ["password reset", "forgot password", "recovery"], ["timing attack", "constant time", "enumeration"], ["breach", "haveibeenpwned", "compromised password", "pwned"], ["CSRF"], ["logout", "invalidate", "session fixation"]]},
    {"id": "observability", "prompt": "Set up complete observability for a distributed system of 12 microservices. Give the exhaustive list of what to instrument and how.", "groups": [["metric", "prometheus", "statsd"], ["log", "structured", "JSON log"], ["trace", "distributed tracing", "OpenTelemetry", "jaeger"], ["correlation", "trace_id", "request id", "propagat"], ["RED", "USE", "golden signal", "latency", "throughput"], ["percentile", "p99", "p95", "histogram"], ["alert", "alerting", "pagerduty", "threshold"], ["SLO", "SLI", "error budget"], ["dashboard", "grafana", "visuali"], ["retention", "sampling", "cardinality", "cost"], ["health check", "readiness", "liveness"], ["error tracking", "sentry", "exception"], ["runbook", "playbook", "documentation"]]},
    {"id": "migration-zero-downtime", "prompt": "You must rename a column on a 500M row table used by 6 services, with zero downtime. Give the complete step-by-step procedure, exhaustively.", "groups": [["add", "new column", "add column"], ["backfill", "batch", "chunk"], ["dual write", "write both", "both columns"], ["read", "fallback", "coalesce", "read from new"], ["deploy", "rollout", "service", "code change"], ["expand", "contract", "expand-contract", "phase"], ["verify", "validate", "consistency", "compare", "reconcil"], ["drop", "remove old", "cleanup"], ["rollback", "roll back", "revert", "reversible"], ["lock", "locking", "blocking", "ACCESS EXCLUSIVE"], ["trigger", "sync", "keep in sync"], ["monitor", "error rate", "watch"], ["index", "constraint", "NOT NULL"]]},
