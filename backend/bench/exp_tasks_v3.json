{
  "design_note": "Round 1 and 2 both failed to discriminate, for the same reason: binary pass/fail on knowledge questions has no power when the model already knows the answer (baseline scored 40/40, then 49/50). These tasks change the measurable quantity from CORRECTNESS to COMPLETENESS. Each asks for an exhaustive checklist/runbook where a genuinely complete answer contains 9-14 distinct required elements. Models reliably produce a partial answer -- they know the topic but stop at the 5-6 most obvious points. That leaves headroom a skill can actually fill, and turns the score into a continuous 0-1 variable with far more statistical power per task than a binary flag. `groups` = required elements; score = fraction of groups present; any token in a group satisfies it. Tasks were written from domain knowledge WITHOUT inspecting either corpus, so neither arm is scouted for.",
  "tasks": [
    {"id": "harden-ssh", "prompt": "Give me a complete production hardening checklist for an internet-facing OpenSSH server. Be exhaustive and specific about sshd_config directives.", "groups": [["PermitRootLogin"], ["PasswordAuthentication", "ChallengeResponseAuthentication"], ["PubkeyAuthentication", "publickey"], ["Port", "non-standard port"], ["AllowUsers", "AllowGroups", "DenyUsers"], ["MaxAuthTries"], ["fail2ban", "sshguard", "rate limit"], ["X11Forwarding"], ["ClientAliveInterval", "LoginGraceTime"], ["Protocol 2", "KexAlgorithms", "Ciphers", "MACs"], ["2FA", "MFA", "TOTP", "google-authenticator"], ["firewall", "ufw", "iptables", "security group"]]},
    {"id": "pg-upgrade", "prompt": "Write the complete runbook for upgrading a production PostgreSQL 14 cluster to 16 with minimal downtime. Cover every step including what to do before, during, and after, and how to roll back.", "groups": [["pg_dump", "pg_dumpall", "backup"], ["pg_upgrade", "logical replication", "pglogical"], ["replica", "standby", "streaming replication"], ["extension", "contrib"], ["ANALYZE", "vacuumdb", "statistics"], ["connection string", "pgbouncer", "connection pool", "application config"], ["rollback", "roll back", "fallback"], ["staging", "test", "dry run", "rehearsal"], ["pg_upgrade --check", "--check", "compatibility"], ["monitor", "verify", "smoke test", "validation"], ["maintenance window", "downtime", "read-only"], ["deprecated", "breaking change", "release notes"]]},
    {"id": "k8s-prod-ready", "prompt": "What makes a Kubernetes Deployment production-ready? Give me the exhaustive checklist of spec fields and cluster-level concerns I must set. Be specific about the YAML.", "groups": [["resources", "requests", "limits"], ["livenessProbe"], ["readinessProbe"], ["replicas", "HorizontalPodAutoscaler", "HPA"], ["PodDisruptionBudget", "PDB"], ["securityContext", "runAsNonRoot", "readOnlyRootFilesystem"], ["rollingUpdate", "maxUnavailable", "maxSurge", "strategy"], ["affinity", "topologySpreadConstraints", "antiAffinity"], ["ServiceAccount", "RBAC"], ["terminationGracePeriodSeconds", "preStop", "graceful"], ["ConfigMap", "Secret"], ["image tag", "digest", "imagePullPolicy", "latest"], ["NetworkPolicy"], ["startupProbe", "initialDelaySeconds"]]},
    {"id": "incident-runbook", "prompt": "Write a complete incident response runbook for a production outage at a SaaS company. Cover the full lifecycle from detection to closure, including roles and communication.", "groups": [["detect", "alert", "page", "monitoring"], ["severity", "sev", "priority", "triage"], ["incident commander", "IC", "role"], ["communication", "status page", "stakeholder", "customer"], ["mitigat", "rollback", "roll back", "revert"], ["escalat"], ["timeline", "log", "document", "scribe"], ["war room", "channel", "bridge", "slack"], ["postmortem", "post-mortem", "retrospective"], ["blameless"], ["action item", "follow-up", "remediation"], ["root cause", "RCA", "contributing factor"], ["customer impact", "SLA", "SLO", "error budget"]]},
    {"id": "api-security", "prompt": "Give me an exhaustive security checklist for a public REST API handling user data and payments. Be specific about mechanisms.", "groups": [["authentication", "OAuth", "JWT"], ["authorization", "RBAC", "scope", "permission"], ["rate limit", "throttl"], ["TLS", "HTTPS", "SSL"], ["input validation", "schema validation", "sanitiz"], ["SQL injection", "parameterized", "prepared statement"], ["CORS"], ["secret", "key management", "vault", "rotation"], ["audit log", "logging", "monitor"], ["PII", "encryption at rest", "encrypt"], ["idempotency", "replay"], ["CSRF", "XSS"], ["dependency", "vulnerability scan", "SCA", "SBOM"], ["error message", "information disclosure", "stack trace"]]},
    {"id": "docker-prod", "prompt": "Give me the complete list of things wrong with a naive production Dockerfile and how to fix each. Be exhaustive and specific about directives.", "groups": [["multi-stage", "multistage", "AS builder"], ["USER", "non-root", "nonroot"], ["slim", "alpine", "distroless", "base image"], ["pin", "digest", "specific version", "latest"], ["\\.dockerignore", "dockerignore"], ["layer", "cache", "COPY requirements", "order"], ["--no-cache-dir", "apt-get clean", "rm -rf /var/lib/apt"], ["HEALTHCHECK"], ["secret", "build arg", "ARG", "--mount=type=secret"], ["EXPOSE", "port"], ["ENTRYPOINT", "CMD", "exec form"], ["signal", "PID 1", "tini", "init"], ["scan", "trivy", "vulnerability"]]},
    {"id": "slow-query", "prompt": "A Postgres query that used to take 50ms now takes 40 seconds. Nothing in the query changed. Walk me through the complete diagnostic process, exhaustively, with commands.", "groups": [["EXPLAIN", "explain analyze"], ["BUFFERS", "ANALYZE", "actual"], ["Seq Scan", "sequential scan", "index scan"], ["ANALYZE", "statistics", "pg_stat", "autovacuum"], ["bloat", "VACUUM", "dead tuple"], ["index", "missing index", "unused index"], ["pg_stat_activity", "lock", "blocking", "pg_locks"], ["data volume", "row count", "growth", "table size"], ["work_mem", "shared_buffers", "configuration", "parameter"], ["plan change", "planner", "cost", "estimate"], ["cache", "buffer", "disk", "IO"], ["connection", "pool", "contention", "concurrency"]]},
    {"id": "memory-leak-prod", "prompt": "A Python web service's memory grows from 200MB to 8GB over 48 hours in production and gets OOM-killed. Give the complete systematic investigation, exhaustively.", "groups": [["tracemalloc", "memray", "objgraph", "guppy", "pympler"], ["snapshot", "diff", "compare", "over time"], ["gc", "garbage collect", "reference cycle"], ["heap", "heap dump", "profil"], ["global", "module-level", "cache", "unbounded"], ["connection", "session", "socket", "file handle", "close"], ["RSS", "monitor", "metric", "grafana", "prometheus"], ["reproduce", "staging", "load test", "replicate"], ["fragmentation", "allocator", "malloc", "arena"], ["C extension", "native", "numpy", "third-party"], ["restart", "mitigation", "worker recycl", "max_requests"], ["logging", "accumulate", "list", "dict", "growing"]]},
    {"id": "ci-pipeline", "prompt": "Design a complete CI/CD pipeline for a Python microservice deploying to Kubernetes. List every stage and what runs in it, exhaustively.", "groups": [["lint", "ruff", "flake8", "black"], ["type", "mypy", "pyright"], ["unit test", "pytest"], ["integration test", "e2e", "end-to-end"], ["coverage"], ["security scan", "bandit", "snyk", "trivy", "SCA"], ["build", "docker build", "image"], ["registry", "push", "ECR", "GHCR"], ["tag", "version", "semver", "sha"], ["staging", "canary", "blue-green", "progressive"], ["smoke test", "health check", "verify"], ["rollback", "roll back"], ["secret", "credential", "OIDC", "vault"], ["cache", "dependency cache", "artifact"], ["approval", "gate", "manual", "protected"]]},
    {"id": "react-perf", "prompt": "A React app's list view with 5,000 rows is janky on scroll and typing lags. Give the complete set of causes and fixes, exhaustively.", "groups": [["virtual", "windowing", "react-window", "react-virtualized", "tanstack"], ["memo", "React.memo"], ["useMemo", "useCallback"], ["key", "index as key", "stable key"], ["debounce", "throttle"], ["profiler", "React DevTools", "flame", "measure"], ["state colocation", "lift", "context", "re-render"], ["controlled", "uncontrolled", "input", "onChange"], ["transition", "useTransition", "useDeferredValue", "concurrent"], ["expensive", "computation", "derived", "selector"], ["CSS", "layout", "reflow", "paint", "will-change"], ["bundle", "code split", "lazy"]]},
    {"id": "terraform-prod", "prompt": "What does a production-grade Terraform setup for a team of 10 need? Give the exhaustive list of practices and configuration.", "groups": [["remote state", "backend", "S3", "terraform cloud"], ["state lock", "DynamoDB", "locking"], ["module"], ["workspace", "environment", "dev", "prod", "separate"], ["version", "required_version", "pin", "constraint"], ["plan", "review", "PR", "pull request"], ["apply", "CI", "automation", "atlantis"], ["secret", "vault", "sensitive", "SOPS"], ["import", "state mv", "drift"], ["tag", "naming convention", "label"], ["policy", "OPA", "sentinel", "tfsec", "checkov"], ["fmt", "validate", "lint"], ["least privilege", "IAM", "role", "permission"], ["blast radius", "small", "separate state", "isolat"]]},
