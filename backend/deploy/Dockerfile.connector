FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY auto_skill_auth.py auto_skill_cli.py auto_skill_core.py auto_skill_identity.py auto_skill_personalize.py mcp_oauth_provider.py mcp_server.py /app/
COPY hooks /app/hooks

RUN pip install --no-cache-dir -e /app

# Same fixed UID as deploy/Dockerfile -- this container doesn't write to the
# bind-mounted data/skills_library volumes itself (it only talks to the api
# container over HTTP), but running as non-root is still cheap defense in
# depth here.
RUN groupadd -g 10001 appuser && useradd -u 10001 -g appuser -M appuser
USER appuser

CMD ["auto-skill-mcp"]
