# Recommended: a GitHub token enables the full repository/code discovery
# budget. Without it the worker intentionally runs a small anonymous crawl.
GITHUB_TOKEN=
SEARXNG_URL=
STALE_SCRAPE_RUN_SECONDS=7200
# The scraper/embedder is an explicit one-shot collector profile, never a
# production service. Conservative defaults keep ONNX within 1 GiB.
EMBED_PAGE_SIZE=64
EMBED_BATCH_SIZE=8
EMBED_UPSERT_CHUNK=50
COLLECTOR_MEMORY_LIMIT=1024m
COLLECTOR_CPU_LIMIT=0.75
AUTO_SKILL_DASHBOARD_ORIGINS=https://autoskill.dev,https://www.autoskill.dev,https://skills.autoskill.dev
BACKEND_BASE_URL=https://skills.autoskill.dev
MCP_ISSUER_URL=https://mcp.autoskill.dev
MCP_ALLOWED_HOSTS=mcp.autoskill.dev,localhost:8765,127.0.0.1:8765
CLOUDFLARED_TOKEN=
# Google OAuth app backing account login (auth.py) -- Google supports
# multiple registered redirect URIs on one app, so add both
# https://skills.avalahome.com/auth/google/callback and
# https://skills.autoskill.dev/auth/google/callback to the same app if both
# hostnames are ever live at once. Leaving these unset disables Google login
# with a 503, it does not break anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth Apps only support ONE callback URL each, so serving login on
# more than one live hostname needs a separate GitHub OAuth App per hostname
# -- see auth.py's GITHUB_CREDENTIALS_BY_HOST. GITHUB_CLIENT_ID/SECRET back
# https://skills.avalahome.com/auth/github/callback;
# GITHUB_CLIENT_ID_AUTOSKILL/SECRET back
# https://skills.autoskill.dev/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID_AUTOSKILL=
GITHUB_CLIENT_SECRET_AUTOSKILL=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=autoskill-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_LIBRARY_PREFIX=skills-library
LIBRARY_BACKUP_INTERVAL_SECONDS=86400
# Context delivery guard is enabled by default; set 0 only for rollback.
AUTOSKILL_CONTEXT_GUARD=1
# Comma-separated exact safe-capsule SHA-256 digests with replicated outcome
# evidence for full capsule delivery. Raw public source is never delivered.
AUTOSKILL_VALIDATED_CAPSULE_DIGESTS=
# Vercel OIDC token for live skills.sh search/detail/audit routing. Without it,
# routing uses the public skills.sh discovery lane (metadata-only hints). The
# local corpus is not a silent public fallback; enable it explicitly only for
# offline development or an outage experiment.
SKILLS_SH_OIDC_TOKEN=
# Optional file refreshed by the deployment's Vercel OIDC/token helper.
SKILLS_SH_OIDC_TOKEN_FILE=
AUTOSKILL_SKILLS_SH_ROUTING=1
AUTOSKILL_ALLOW_LOCAL_RETRIEVAL_FALLBACK=0
AUTOSKILL_SKILLS_SH_SEARCH_LIMIT=12
SKILLS_SH_API_URL=https://skills.sh/api/v1
SKILLS_SH_PUBLIC_PAGE_METADATA=1
SKILLS_SH_MAX_CONCURRENT_REQUESTS=4
SKILLS_SH_MAX_RETRIES=3
SKILLS_SH_RETRY_BASE_SECONDS=0.5
SKILLS_SH_MIN_REQUEST_INTERVAL_SECONDS=0.1
# Durable/shared mirror for hydrated skills.sh records. Warm routing is local-
# first; upstream calls are reserved for mirror misses and refresh work.
SKILLS_SH_MIRROR_DB_PATH=backend/.skills_sh_mirror.db
SKILLS_SH_MIRROR_STALE_SECONDS=3600
SKILLS_SH_DISCOVERY_LIMIT=50
SKILLSMP_DISCOVERY_LIMIT=100
# Controlled benchmark bypass only. Keep disabled in production.
AUTOSKILL_EXPERIMENTAL_UNVALIDATED_PUBLIC_FULL=0
# Free accounts receive this many task-shaped routes per UTC calendar month.
AUTOSKILL_FREE_ROUTES_PER_MONTH=100
# Founder administration is SSH-only. The public api service hard-disables all
# admin routes; admin-local is published only on droplet loopback port 8002.
# Do not change this host or add admin-local to the Cloudflare network.
ADMIN_ACCESS_MODE=ssh
ADMIN_HOST=127.0.0.1
ADMIN_EMAILS=
# Stripe is the sole source of paid access. These values are secrets except
# for price IDs. Set test mode so customer links open the test dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_SEAT=
STRIPE_DASHBOARD_TEST_MODE=0
# Anonymous installation hashes are client opt-in and expire from route events
# after this many days; no raw installation IDs or prompts are retained.
AUTOSKILL_ANONYMOUS_ID_RETENTION_DAYS=90
