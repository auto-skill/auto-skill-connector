GITHUB_TOKEN=
SEARXNG_URL=
STALE_SCRAPE_RUN_SECONDS=7200
AUTO_SKILL_DASHBOARD_ORIGINS=https://auto-skill.com,https://www.auto-skill.com
BACKEND_BASE_URL=https://api.auto-skill.com
MCP_ISSUER_URL=https://mcp.auto-skill.com
MCP_ALLOWED_HOSTS=mcp.auto-skill.com,localhost:8765,127.0.0.1:8765
CLOUDFLARED_TOKEN=
# Google/GitHub OAuth apps backing account login (auth.py) -- redirect URIs
# must be exactly https://api.auto-skill.com/auth/google/callback and
# https://api.auto-skill.com/auth/github/callback. Leaving these unset
# disables that provider's login with a 503, it does not break anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=autoskill-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_LIBRARY_PREFIX=skills-library
LIBRARY_BACKUP_INTERVAL_SECONDS=86400
