GITHUB_TOKEN=
SEARXNG_URL=
STALE_SCRAPE_RUN_SECONDS=7200
CLOUDFLARED_TOKEN=
# Google/GitHub OAuth apps backing account login (auth.py) -- redirect URIs
# must be exactly https://skills.avalahome.com/auth/google/callback and
# https://skills.avalahome.com/auth/github/callback. Leaving these unset
# disables that provider's login with a 503, it does not break anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=autoskill-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_LIBRARY_PREFIX=skills-library
LIBRARY_BACKUP_INTERVAL_SECONDS=86400
