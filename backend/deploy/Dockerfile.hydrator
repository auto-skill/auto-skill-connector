FROM python:3.12-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir httpx numpy \
    && groupadd -g 10001 appuser \
    && useradd -u 10001 -g appuser -M appuser

COPY hydrate_github_packages.py local_store.py package_store.py quality.py capsule_compiler.py /app/
RUN chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1
